{
  "name": "@catronomix/opencode-session-dashboard",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Fullscreen OpenCode TUI dashboard showing every open session and subagent with context fill, tokens, cost and idle screensavers.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-plugin-tui",
    "dashboard",
    "sessions",
    "subagents",
    "tui"
  ],
  "homepage": "https://github.com/catronomix/opencode-dashboard-plugin#readme",
  "bugs": {
    "url": "https://github.com/catronomix/opencode-dashboard-plugin/issues"
  },
  "author": "Innocent Coppieters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catronomix/opencode-dashboard-plugin.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/dashboard.test.ts test/npm-readiness.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "release-check": "node scripts/release-check.mjs",
    "prepack": "node scripts/release-check.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.4",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
